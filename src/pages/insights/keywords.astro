---
import { u } from '../../lib/url';
import { n, money, chg, pctOf } from '../../lib/num';
import Layout from '../../layouts/Layout.astro';
import TabsScript from '../../components/TabsScript.astro';
import AlgaeCompare from '../../components/AlgaeCompare.astro';
import FxTable from '../../components/FxTable.astro';
import K from '../../content/insights/keywords.json';
import V from '../../content/insights/view.json';
import F from '../../content/insights/research/forecasts.json';
import T from '../../content/insights/research/nextgen_tech.json';
const v: any = V;
const TABS: [string, string][] = [
  ['summary', '요약'], ['w10', '10년 (2016–2026)'], ['w5', '5년 (2021–2026)'], ['w2', '2년 (2024–2026)'],
  ['comp', '경쟁사 비교'], ['budget', '국가별 예산 (USD)'], ['forecast', '예산·시장 전망'], ['tech', '차세대 기술'], ['algae', '녹조·슬러지 업체 비교'],
  ['video', '영상 자료 분석'], ['sources', '출처 신뢰도·인기도'], ['reco', '추천 키워드'],
];

// ---- 기간 탭 ----
const mono = Object.entries(K.trends.nokjo_monthly as Record<string, number>).sort();
const LW = 760, LH = 200, LP = 30;
const lmax = Math.max(1, ...mono.map((p) => p[1]));
const lxy = mono.map(([, val], i) => [LP + (i * (LW - LP * 2)) / Math.max(1, mono.length - 1), LH - LP - (val / lmax) * (LH - LP * 2)]);
const lineD = 'M' + lxy.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L');
const yearsAxis = Array.from({ length: 11 }, (_, i) => 2016 + i);
const lineSvg = `<svg viewBox="0 0 ${LW} ${LH + 10}" role="img" aria-label="한국 '녹조' 월별 관심도 2016–2026 선 그래프">`
  + yearsAxis.map((y, i) => { const x = LP + (i * 12 * (LW - LP * 2)) / (mono.length - 1); return `<line x1="${x}" x2="${x}" y1="14" y2="${LH - LP}" stroke="#edf3f4"/><text x="${x}" y="${LH - 10}" font-size="12" fill="#5f727c" text-anchor="middle">${y}</text>`; }).join('')
  + `<path d="${lineD}" fill="none" stroke="#2f8f5b" stroke-width="2"/></svg>`;
const kr: any = K.trends.kr;
const krTerms: [string, string, string][] = [['KR_core', '녹조', 'A'], ['KR_core', '토양오염', 'A'], ['KR_core', '수질개선', 'A'], ['KR_core', '악취제거', 'A'], ['KR_micro', '수질정화', 'B'], ['KR_micro', '녹조제거', 'B'], ['KR_micro', '축산악취', 'B'], ['KR_micro', '미생물제제', 'B']];
const winKey: Record<string, '10y' | '5y' | '2y'> = { w10: '10y', w5: '5y', w2: '2y' };
const winLabel: Record<string, string> = { w10: '2016–2026', w5: '2021–2026', w2: '2024–2026' };
const snapYear: Record<string, string> = { w10: '2016', w5: '2021', w2: '2024' };
const winCountry: Record<string, string> = { w10: '2016-2026', w5: '2021-2026', w2: '2024-2026' };
const oaStart: Record<string, string> = { w10: '2016', w5: '2021', w2: '2024' };
const wikiPick = (K.wiki as any[]).filter((r) => ['Algal_bloom', 'Harmful_algal_bloom', 'Eutrophication', 'Bioremediation', 'Bioaugmentation', 'Effective_microorganism'].includes(r.article) && ['en', 'ko', 'zh', 'ru', 'vi', 'id'].includes(r.lang));
const oaRows = K.openalex as any[];
const intlRows = Object.values((K.trends as any).intl || {}).flatMap((g: any) =>
  g.terms ? Object.entries(g.terms).map(([term, val]: any) => ({ label: g.label, term, v: val })) : [{ label: g.label, term: null, v: null }]
) as any[];
const lowSample = (x: any) => x.zero_months * 3 > x.months;
const splitEvent = (e: string) => {
  const m = e.match(/^([^:：]{2,26})[:：]\s*(.+)$/);
  if (m) return [m[1], m[2]];
  const y = e.match(/^(\d{4}(?:[–.\-~]\d{2,4})?)\s+(.+)$/);
  return y ? [y[1], y[2]] : ['—', e];
};

// ---- 경쟁사 ----
const comps = (K.competitors as any[]).map((c) => ({ ...c, name: c.self ? '바이오밴코리아 (자사)' : c.name }));
const serp = K.serp as any[];
const yn = (b: any) => (b === true ? '적용' : b === false ? '미적용' : '미확인');
const wbTxt = (c: any) => (c.wayback_months ? `Wayback ${c.wayback_months}${c.wayback_mode === '연' ? '개 연도' : '개월'}${c.wayback_first ? ` (첫 ${c.wayback_first})` : ''}` : 'Wayback 미수집');

// ---- 전망·기술·추천 ----
const fc = v.forecasts as any[];
const fcImpl = fc.filter((f, i) => fc.findIndex((g) => g.id === f.id) === i);
const tech = v.tech as any[];
const reco: any = K.reco;
const recoRows: any[] = [];
for (const [, r] of Object.entries(reco) as any) {
  r.primary.forEach(([k, why]: any) => recoRows.push({ lang: r.label, kind: '주력 (제목·H1)', kw: k, why }));
  recoRows.push({ lang: r.label, kind: '보조 (본문·H2)', kw: r.secondary.join(' · '), why: '—' });
  recoRows.push({ lang: r.label, kind: '롱테일 (사례·FAQ)', kw: r.longtail.join(' · '), why: '—' });
  if (r.b2g) recoRows.push({ lang: r.label, kind: 'B2G (공공 발주)', kw: r.b2g.join(' · '), why: '—' });
}
const todo: [string, string][] = [
  ['기술 SEO 기본', 'HTTPS 적용, 페이지마다 고유 title·meta description(아래 제안안), 홈에 H1 1개'],
  ['브랜드 구분', "Organization 구조화 데이터(name: BIOVAN KOREA / 바이오밴코리아, sameAs, 주소 확정 후) — 동명 식품기업 'Biovan'과 구분"],
  ['사례 제목', '"지역 + 수체 + 문제 + 결과" 형식. 예) "평택 배다리호수 물고기 폐사 방지 — 2024~2026 여름 수질 관리"'],
  ['사례 수치', '사례마다 전후 수질 수치(T-N·T-P·COD·클로로필-a) 표 추가 — 경쟁사(AdvancedWater·邦源)는 결과 수치로 노출'],
  ['시즌 콘텐츠', "녹조 시즌 전(5~6월) 갱신, '녹조 Q&A' 정보형 글로 논문·뉴스가 차지한 정보 의도 검색에 대응"],
  ['다국어', "중문은 '绿藻' 대신 '蓝藻治理·水体修复·黑臭水体治理', 영문은 HAB·bioremediation·sludge reduction 중심 축약판"],
  ['조달 문구', "조달청 등록 여부 확인 후 등록돼 있으면 '조달청 등록' 문구 사용(진바이오틱스·중앙바이오텍이 사용 중)"],
];
---
<Layout title="키워드·시장 분석" description="바이오밴코리아 키워드·경쟁사·국가별 예산·차세대 기술 분석(내부 참고용 시안)">
  <div class="phead"><div class="wrap">
    <div class="crumbs"><a href={u('/')}>홈</a> / 인사이트</div>
    <h1>키워드·시장 분석</h1>
    <p>경쟁사, 검색 노출, 관심도(10·5·2년), 국가별 예산, 차세대 기술을 표로 정리했습니다. 2026-10-08(KST) 수집. <b style="color:#fff">금액은 모두 USD(해당 연도 연평균 환율)입니다.</b></p>
  </div></div>

  <div class="tabbar"><div class="wrap">
    <div class="tablist" role="tablist" aria-label="분석 항목" data-main>
      {TABS.map(([id, label], i) => <button class="tab" role="tab" id={`t-${id}`} aria-controls={`p-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={id}>{label}</button>)}
    </div>
  </div></div>

  <div class="wrap">
    <!-- 요약 -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-summary" aria-labelledby="t-summary" tabindex="0">
      <h2>요약</h2>
      <p class="intro">공개 자료만으로 바이오밴코리아의 검색 노출, 관심도 추이, 경쟁 환경을 정리한 핵심 결과입니다.</p>
      <p class="cv">순위·관심도는 관찰값과 상대지수이며 실제 검색량이 아닙니다.</p>
      <h3>핵심 수치</h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th>항목</th><th>수치</th><th>의미</th></tr></thead>
        <tbody>{v.summary.map((r: string[]) => <tr><th scope="row" class="w-s">{r[0]}</th><td class="w-m"><b>{r[1]}</b></td><td class="w-l">{r[2]}</td></tr>)}</tbody>
      </table></div>
      <h3>기간별 요약</h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th>기간</th><th>요약</th></tr></thead>
        <tbody>{v.periods.map((r: string[]) => <tr><th scope="row" class="w-s">{r[0]}</th><td>{r[1]}</td></tr>)}</tbody>
      </table></div>
      <details class="mth"><summary>방법·한계</summary>
        <ul>
          <li>Ahrefs·Semrush·Search Console 같은 유료·계정 데이터 없이 공개 자료로 근사했습니다.</li>
          <li>검색 노출은 검색 도구 외부 인덱스의 상위 5개 결과이며, Google·네이버 실제 순위와 다를 수 있습니다.</li>
          <li>Google Trends 값은 같은 질의 묶음 안에서만 비교할 수 있는 0~100 상대지수입니다.</li>
          <li>자사 사이트(biovankorea.com)에는 요청을 보내지 않았고, 기존 수집본을 사용했습니다.</li>
          <li>금액은 모두 USD로 통일했습니다. 환율 기준은 '예산·시장 전망' 탭의 방법·한계에 있습니다.</li>
        </ul>
      </details>
    </section>

    <!-- 기간 탭 -->
    {['w10', 'w5', 'w2'].map((w) => {
      const wk = winKey[w];
      return (
      <section class="tabpanel ipanel" role="tabpanel" id={`p-${w}`} aria-labelledby={`t-${w}`} tabindex="0">
        <h2>{winLabel[w]} 기간 비교</h2>
        <p class="intro">{K.findings[wk]}</p>
        <p class="cv">관심도는 같은 질의 묶음 안에서만 비교할 수 있는 상대지수(0~100)입니다. 기준 기간은 2016–20 평균입니다.</p>

        <h3>한국 검색 관심도 <span class="unit">(Google Trends KR, 월평균 지수)</span></h3>
        <div class="tblwrap"><table class="tbl">
          <thead><tr><th>검색어</th><th class="c">묶음</th><th class="num">2016–20</th><th class="num">{winLabel[w]}</th><th class="num">변화</th></tr></thead>
          <tbody>{krTerms.map(([s, t, g]) => { const cur = kr[s][t][wk], p = kr[s][t]['prev']; return <tr><th scope="row">{t}</th><td class="c">{g}</td><td class="num">{n(p, 1)}</td><td class="num"><b>{n(cur, 1)}</b></td><td class="num">{chg(pctOf(cur, p))}</td></tr>; })}</tbody>
        </table></div>
        <p class="mnote">묶음 A와 B는 따로 조회해 묶음 간 값은 비교할 수 없습니다.</p>

        {w === 'w10' && (
          <figure class="svgc">
            <figcaption class="tcap" style="margin-bottom:6px">'녹조' 월별 관심도 (KR, 최대 = {lmax})</figcaption>
            <Fragment set:html={lineSvg} />
            <p class="mnote">매년 여름(대개 8월) 정점이 반복됩니다. 녹조 페이지·사례는 5~6월 전에 갱신하는 것이 좋습니다.</p>
          </figure>
        )}

        <h3>해외 국가별 관심도 <span class="unit">(Google Trends, 월평균 지수)</span></h3>
        <div class="tblwrap"><table class="tbl">
          <thead><tr><th>국가</th><th>검색어</th><th class="num">2016–20</th><th class="num">{winLabel[w]}</th><th class="num">변화</th><th>비고</th></tr></thead>
          <tbody>{intlRows.map((r) => r.term === null
            ? <tr><th scope="row">{r.label}</th><td class="dim">—</td><td class="num dim">—</td><td class="num dim">—</td><td class="num dim">—</td><td>미수집(요청 제한)</td></tr>
            : <tr><th scope="row">{r.label}</th><td>{r.term}</td><td class="num">{n(r.v.prev, 1)}</td><td class="num"><b>{n(r.v[wk], 1)}</b></td><td class="num">{chg(pctOf(r.v[wk], r.v.prev))}</td><td>{lowSample(r.v) ? `표본 적음 (0인 달 ${r.v.zero_months}/${r.v.months})` : ''}</td></tr>)}</tbody>
        </table></div>

        <h3>위키백과 월평균 조회수 <span class="unit">(회, 봇 제외)</span></h3>
        <div class="tblwrap"><table class="tbl">
          <thead><tr><th>주제</th><th>언어 · 문서</th><th class="num">2016–20</th><th class="num">{winLabel[w]}</th><th class="num">변화</th></tr></thead>
          <tbody>{wikiPick.map((r) => { const cur = r[w]; return <tr><th scope="row">{r.article.replace(/_/g, ' ')}</th><td>{r.lang} · {r.title}</td><td class="num">{n(r.prev)}</td><td class="num"><b>{n(cur)}</b></td><td class="num">{chg(pctOf(cur, r.prev))}</td></tr>; })}</tbody>
        </table></div>

        <h3>연구 논문 수 <span class="unit">(OpenAlex, 건)</span></h3>
        <div class="tblwrap"><table class="tbl">
          <thead><tr><th>검색식</th><th class="num">{oaStart[w]}</th><th class="num">2025</th><th class="num">변화</th><th>저자 국가 상위 3 ({winLabel[w]})</th></tr></thead>
          <tbody>{oaRows.map((r) => { const a = r.yearly[oaStart[w]], b = r.yearly['2025']; const cs = r.countries[winCountry[w]] || []; return <tr><th scope="row">{r.query}</th><td class="num">{n(a)}</td><td class="num"><b>{n(b)}</b></td><td class="num">{chg(pctOf(b, a))}</td><td>{cs.length ? cs.slice(0, 3).map((c: any) => `${c[0]} ${n(c[1])}`).join(' · ') : '—'}</td></tr>; })}</tbody>
        </table></div>

        <h3>경쟁사·시장 변화</h3>
        <div class="tblwrap"><table class="tbl">
          <thead><tr><th>시기</th><th>내용</th></tr></thead>
          <tbody>{(K.events[wk] as string[]).map((e) => { const [p, t] = splitEvent(e); return <tr><th scope="row" class="w-s">{p}</th><td>{t}</td></tr>; })}</tbody>
        </table></div>

        <h3>경쟁사 홈페이지 제목 <span class="unit">(Wayback {snapYear[w]}년 7월 전후)</span></h3>
        <div class="tblwrap"><table class="tbl">
          <thead><tr><th>도메인</th><th>당시 제목</th><th>본문 상위 단어</th></tr></thead>
          <tbody>{(K.snapshots as any[]).filter((s) => s.year === snapYear[w]).map((s) => <tr><th scope="row">{s.domain}</th><td>{s.error ? <span class="dim">스냅샷 없음</span> : (s.title || <span class="dim">(제목 없음)</span>)}</td><td>{(s.terms || []).slice(0, 6).join(', ') || '—'}</td></tr>)}</tbody>
        </table></div>

        <details class="mth"><summary>방법·한계</summary>
          <ul>
            <li>Google Trends: pytrends로 2026-10-08 수집. 값은 질의 묶음마다 최댓값=100으로 정규화한 상대지수입니다. 묶음 A(녹조·토양오염·수질개선·악취제거), 묶음 B(수질정화·녹조제거·축산악취·미생물제제, '녹조'와 함께 조회).</li>
            <li>해외: 국가마다 질의 묶음이 달라 국가 간 비교는 의미가 없습니다. '값 0인 달'이 1/3을 넘으면 '표본 적음'으로 표시했습니다. {K.trends.ww_note}.</li>
            <li>위키백과: Wikimedia Pageviews API(2016-01~2026-09). 일반 주제 조회는 전반적으로 감소 추세라, 감소 폭이 작거나 증가한 주제가 상대적으로 뜨는 주제입니다.</li>
            <li>OpenAlex: 2026년은 집계 중이라 2025년과 비교했습니다. 전체 논문 수 집계가 2025–26년에 비정상적으로 커서 비율 정규화는 하지 않았습니다.</li>
            <li>홈페이지 제목: 스냅샷이 없거나 차단 화면이 보관된 경우 '스냅샷 없음·제목 없음'으로 표시했습니다.</li>
          </ul>
        </details>
      </section>);
    })}

    <!-- 경쟁사 -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-comp" aria-labelledby="t-comp" tabindex="0">
      <h2>경쟁사 비교 ({comps.length - 1}곳 + 자사)</h2>
      <p class="intro">경쟁사 홈페이지와 검색 결과를 직접 확인해 포지셔닝, 웹 기본기, 검색 노출을 비교했습니다. 노란 배경 행이 자사입니다.</p>
      <p class="cv">신뢰도·인기도는 1~5점 근사치이며, 검색 노출은 외부 인덱스 상위 5개 기준입니다.</p>
      <h3>개요</h3>
      <div class="tblwrap"><table class="tbl s1">
        <thead><tr><th>회사</th><th>국가</th><th>포지셔닝</th><th>핵심 키워드 (관찰)</th><th>홈 제목</th><th>언어</th></tr></thead>
        <tbody>{comps.map((c) => <tr class={c.self ? 'self' : ''}>
          <th scope="row"><b>{c.name}</b><span class="sub"><a href={c.url} rel="noopener nofollow" target="_blank">{c.domain}</a></span></th>
          <td>{c.region}</td><td class="w-l">{c.positioning}</td><td class="w-m">{c.keywords}</td><td class="w-m">{c.title}</td><td>{c.langs}</td>
        </tr>)}</tbody>
      </table></div>
      <h3>웹 기본기·인지도</h3>
      <div class="tblwrap"><table class="tbl s1">
        <thead><tr><th>회사</th><th class="c">HTTPS</th><th class="c">설명문(meta)</th><th>구조화 데이터</th><th class="num">신뢰도 (1–5)</th><th class="num">인기도 (1–5)</th><th class="num">검색 노출 (회)</th><th>비고</th></tr></thead>
        <tbody>{comps.map((c) => <tr class={c.self ? 'self' : ''}>
          <th scope="row">{c.name}</th><td class="c">{yn(c.https)}</td><td class="c">{c.meta_desc}</td><td>{c.schema}</td>
          <td class="num">{n(c.credibility, 1)}</td><td class="num">{n(c.popularity)}</td><td class="num">{n(c.serp_hits)}</td>
          <td>{c.tranco ? `Tranco ${n(c.tranco)}위` : 'Tranco 100만 위 밖'} · {wbTxt(c)}</td>
        </tr>)}</tbody>
      </table></div>
      <h3>검색 노출 관찰 <span class="unit">({serp.length}개 질의, 상위 5개)</span></h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th class="c">언어</th><th>질의</th><th>상위 도메인</th><th>관찰</th><th class="c">자사</th></tr></thead>
        <tbody>{serp.map((s) => <tr><td class="c">{s.lang}</td><th scope="row">{s.query}</th><td class="w-l">{s.domains.join(' · ')}</td><td>{s.note}</td><td class="c">{s.biovan ? '노출' : s.third_party ? '기사로만' : <span class="dim">미노출</span>}</td></tr>)}</tbody>
      </table></div>
      <details class="mth"><summary>방법·한계</summary>
        <ul>
          <li>홈페이지는 직접 읽거나(접속 불가 시 공개 페이지 조회 도구) 검색 결과 요약으로 확인했습니다.</li>
          <li>검색 노출 관찰: 2026-10-08 01:40~02:00 KST, 검색 도구의 외부 인덱스 기준. 실제 Google·네이버 순위와 다를 수 있으며 검색량·순위를 만들어 넣지 않았습니다.</li>
          <li>인기도는 Tranco 순위와 Wayback 수집 이력으로 근사했습니다. '미확인'은 확인하지 못한 항목입니다.</li>
        </ul>
      </details>
    </section>

    <!-- 예산 (본문은 /insights/keywords/budget/ 에서 지연 로드) -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-budget" aria-labelledby="t-budget" tabindex="0">
      <h2>국가별 공공예산 — 연도별 (2016–2027, 백만 USD)</h2>
      <div class="lazyph" data-lazy={u('/insights/keywords/budget/')}><p class="note">연도별 표를 불러오는 중… <a href={u('/insights/keywords/budget/')}>별도 페이지에서 보기</a></p></div>
    </section>

    <!-- 전망 -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-forecast" aria-labelledby="t-forecast" tabindex="0">
      <h2>예산·시장 전망</h2>
      <p class="intro">정부 예산안·계획과 민간 시장조사 전망을 한 표에 모았습니다. 금액은 모두 백만 USD입니다.</p>
      <p class="cv">민간 시장조사 수치는 보고서마다 정의가 달라 서로 더하거나 비교하면 안 됩니다.</p>
      <h3>전망 수치 <span class="unit">(금액: 백만 USD)</span></h3>
      <div class="tblwrap"><table class="tbl s1">
        <thead><tr><th>항목</th><th>지역</th><th>기간</th><th class="num">금액 (백만 USD)</th><th>구분</th><th class="num">신뢰도 (1–5)</th><th>출처</th></tr></thead>
        <tbody>{fc.map((f) => <tr>
          <th scope="row" class="w-m">{f.title}{f.note && <span class="sub nt">{f.note}</span>}</th>
          <td>{f.region}</td><td>{f.horizon}</td><td class="num"><b>{f.v == null ? <span class="dim">금액 없음</span> : money(f.v)}</b></td>
          <td>{f.kind}</td><td class="num">{n(f.cred, 1)}</td>
          <td><a href={f.url} rel="noopener nofollow" target="_blank">{f.pub}</a><span class="sub">{f.date}</span></td>
        </tr>)}</tbody>
      </table></div>
      <h3>바이오밴 시사점</h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th>지역</th><th>항목</th><th>시사점</th></tr></thead>
        <tbody>{fcImpl.map((f) => <tr><td>{f.region}</td><th scope="row" class="w-m">{f.id === 'F01' ? '2027 정부안 (녹조·가축분뇨)' : f.title}</th><td class="w-l">{f.impl}</td></tr>)}</tbody>
      </table></div>
      <details class="mth"><summary>방법·한계</summary>
        <ul>
          <li>{(F as any).meta.note}</li>
          <li>'→'는 시작 연도 값 → 목표 연도 값입니다. '/년'은 연간 금액입니다. 금액 칸이 '금액 없음'인 항목은 원문에 금액이 없는 계획·일정입니다.</li>
          <li>현지통화 금액은 해당 연도(회계연도는 시작 연도) 연평균 환율로 USD 환산했습니다. 2026·2027년은 2025년 연평균을 쓴 추정입니다. 민간 보고서의 USD 원값은 그대로 사용했습니다.</li>
        </ul>
        <h4>환율표 (1 USD당 현지통화, 연평균)</h4>
        <FxTable />
      </details>
    </section>

    <!-- 차세대 기술 -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-tech" aria-labelledby="t-tech" tabindex="0">
      <h2>동종업계 차세대 기술</h2>
      <p class="intro">녹조·수질·미생물 분야에서 바이오밴과 관련성이 높은 기술을 우선순위대로 정리했습니다.</p>
      <p class="cv">성숙도·관련성은 공개 자료 기반 판단이며, 신뢰도는 1~5점 근사치입니다.</p>
      <h3>기술 목록</h3>
      <div class="tblwrap"><table class="tbl s1">
        <thead><tr><th>기업·기관</th><th class="num">순위</th><th>국가</th><th>분야</th><th>성숙도</th><th>관련성</th><th class="num">신뢰도 (1–5)</th></tr></thead>
        <tbody>{tech.map((t) => <tr><th scope="row">{t.company}</th><td class="num">{t.top_rank ?? '—'}</td><td>{t.country}</td><td class="w-m">{t.category}</td><td>{t.maturity}</td><td>{t.relevance_to_biovan}</td><td class="num">{n(t.credibility, 1)}</td></tr>)}</tbody>
      </table></div>
      <h3>기술 내용과 바이오밴 영향</h3>
      <div class="tblwrap"><table class="tbl s1">
        <thead><tr><th>기업·기관</th><th>기술</th><th>위협</th><th>바이오밴 기회</th></tr></thead>
        <tbody>{tech.map((t) => <tr><th scope="row">{t.company}</th><td class="w-l">{t.technology}</td><td class="w-m">{t.threat}</td><td class="w-l">{t.opportunity}</td></tr>)}</tbody>
      </table></div>
      <details class="mth"><summary>방법·한계</summary>
        <p class="mnote">{(T as any).meta.note}</p>
        <div class="tblwrap"><table class="tbl">
          <thead><tr><th>기업·기관</th><th>근거</th><th>시점</th><th>자료</th></tr></thead>
          <tbody>{tech.map((t) => <tr><th scope="row">{t.company}</th><td>{t.evidence}</td><td>{t.date}</td><td>{(t.source_urls || []).map((s: string, i: number) => <a href={s} rel="noopener nofollow" target="_blank" style="margin-right:8px">자료{i + 1}</a>)}</td></tr>)}</tbody>
        </table></div>
      </details>
    </section>

    <!-- 녹조·슬러지 업체 비교 -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-algae" aria-labelledby="t-algae" tabindex="0">
      <h2>녹조·슬러지 업체 비교</h2>
      <AlgaeCompare />
    </section>

    <!-- 영상 -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-video" aria-labelledby="t-video" tabindex="0">
      <h2>영상 자료 분석</h2>
      <div class="lazyph" data-lazy={u('/insights/keywords/video/')}><p class="note">영상 분석을 불러오는 중… <a href={u('/insights/keywords/video/')}>별도 페이지에서 보기</a></p></div>
    </section>

    <!-- 출처 (본문은 /insights/keywords/sources/ 에서 지연 로드) -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-sources" aria-labelledby="t-sources" tabindex="0">
      <h2>출처 신뢰도·인기도 ({v.sources.length}건)</h2>
      <div class="lazyph" data-lazy={u('/insights/keywords/sources/')}><p class="note">출처 표를 불러오는 중… <a href={u('/insights/keywords/sources/')}>별도 페이지에서 보기</a></p></div>
    </section>

    <!-- 추천 -->
    <section class="tabpanel ipanel" role="tabpanel" id="p-reco" aria-labelledby="t-reco" tabindex="0">
      <h2>추천 키워드</h2>
      <p class="intro">관찰 근거가 있는 키워드만 언어별·용도별로 정리했습니다.</p>
      <p class="cv">관심도 수치는 상대지수이며 실제 검색량이 아닙니다.</p>
      <h3>언어별 추천 키워드</h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th>언어</th><th>구분</th><th>키워드</th><th>근거</th></tr></thead>
        <tbody>{recoRows.map((r) => <tr><td>{r.lang}</td><td>{r.kind}</td><th scope="row" class="w-m">{r.kw}</th><td class="w-l">{r.why === '—' ? <span class="dim">—</span> : r.why}</td></tr>)}</tbody>
      </table></div>
      <h3>페이지별 키워드 배치</h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th>경로</th><th>페이지</th><th>한국어</th><th>영어</th></tr></thead>
        <tbody>{(K.pages as any[]).map((p) => <tr><td><code>{p.path}</code></td><th scope="row">{p.name}</th><td>{p.ko}</td><td>{p.en}</td></tr>)}</tbody>
      </table></div>
      <h3>제목·설명문(meta) 제안</h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th>경로</th><th class="c">언어</th><th>title</th><th class="num">글자</th><th>meta description</th><th class="num">글자</th></tr></thead>
        <tbody>{(K.titles as any[]).map((t) => <tr><td><code>{t.path}</code></td><td class="c">{t.lang}</td><td class="w-m">{t.title}</td><td class="num">{t.tlen}</td><td class="w-l">{t.desc}</td><td class="num">{t.dlen}</td></tr>)}</tbody>
      </table></div>
      <h3>바로 할 일</h3>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th class="num">순서</th><th>항목</th><th>내용</th></tr></thead>
        <tbody>{todo.map(([a, b], i) => <tr><td class="num">{i + 1}</td><th scope="row" class="w-s">{a}</th><td>{b}</td></tr>)}</tbody>
      </table></div>
    </section>
  </div>

  <TabsScript />
</Layout>
