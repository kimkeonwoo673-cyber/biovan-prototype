---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WQChart from '../components/WQChart.astro';
import { getCollection } from 'astro:content';
import stats from '../data/stats.json';
import { REGIONS } from '../components/FieldIcon';

const projects = (await getCollection('projects')).sort((a, b) => b.data.no - a.data.no);
const latest = projects[0];
const featured = projects.filter((p) => p.data.featured).slice(0, 6);
const byField = (f: string) => projects.filter((p) => p.data.fields.includes(f)).length;
const regionCounts = REGIONS.map((r) => ({ r, n: projects.filter((p) => p.data.region === r).length }));
const maxR = Math.max(...regionCounts.map((x) => x.n));
const years: Record<string, number> = {};
for (const p of projects) years[p.data.posted.slice(0, 4)] = (years[p.data.posted.slice(0, 4)] ?? 0) + 1;
const yearList = Array.from({ length: 2026 - 2014 + 1 }, (_, i) => String(2014 + i)).map((y) => ({ y, n: years[y] ?? 0 }));
const maxY = Math.max(...yearList.map((x) => x.n));

const solutions = [
  { icon: 'algae', t: '녹조 · 악취 제거', d: '녹조의 원인인 질소(T-N)·인(T-P)을 미생물로 저감하고, 하수처리장·유수지의 악취를 줄입니다.', f: ['녹조', '악취'], a: 'algae' },
  { icon: 'river', t: '하천 정화', d: '하상 슬러지를 정화해 하천 스스로의 자정능력을 회복시킵니다.', f: ['하천'], a: 'river' },
  { icon: 'lake', t: '저수지 · 호수 정화', d: '준설 없이 바닥에 쌓인 유기성 슬러지를 분해하는 생물학적 공법입니다.', f: ['호수·저수지'], a: 'lake' },
  { icon: 'soil', t: '토양 정화', d: '탄화수소 주성분의 유류오염 토양을 토양미생물로 무해한 상태로 전환합니다.', f: ['토양'], a: 'soil' },
  { icon: 'barn', t: '축산환경 개선', d: '우사·돈사·계사의 악취를 줄이고 분뇨를 무취 액비로 자원화합니다.', f: ['축산'], a: 'livestock' },
];
const milestones = [
  ['1999', '미생물 사업 착수'], ['2001', 'ISO 9001 · 14001 인증'], ['2002', '법인 설립'],
  ['2013', '미생물 제제 제조방법 특허'], ['2015', '미국법인 설립'], ['2018', "'바이오밴' 상표등록"], ['2026', '키르기스스탄 이식쿨 협력 논의'],
];
---
<Layout>
  <section class="hero">
    <div class="bubbles" aria-hidden="true">
      <span style="left:8%;width:18px;height:18px;animation-duration:14s"></span>
      <span style="left:22%;width:34px;height:34px;animation-duration:19s;animation-delay:-6s"></span>
      <span style="left:47%;width:12px;height:12px;animation-duration:12s;animation-delay:-3s"></span>
      <span style="left:63%;width:26px;height:26px;animation-duration:17s;animation-delay:-9s"></span>
      <span style="left:81%;width:16px;height:16px;animation-duration:13s;animation-delay:-2s"></span>
      <span style="left:92%;width:40px;height:40px;animation-duration:23s;animation-delay:-12s"></span>
    </div>
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Environmental Microbial Solutions · Since 1999</span>
        <h1>미생물의 힘으로<br /><em>물과 흙의 자정능력</em>을 되살립니다</h1>
        <p class="lead">응집제 같은 1회성 처리가 아닌 생물학적 토양정화·수질관리로 T-N, T-P를 저감합니다. 녹조·악취 제거부터 하천·저수지 정화, 유류오염 토양 복원, 축산환경 개선까지.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={u('/projects/')}>프로젝트 보기 <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={u('/contact/')}>상담 문의</a>
        </div>
        <div class="tags"><span>#자연친화적</span><span>#하상슬러지정화</span><span>#자정능력회복</span><span>#질소·인 저감</span></div>
      </div>
      <aside class="hero-card">
        <span class="k">Latest Project</span>
        <h3><a href={u(`/projects/${latest.id}/`)} style="text-decoration:none">{latest.data.title}</a></h3>
        <p>{latest.data.location}</p>
        {projects.slice(1, 4).map((p) => (
          <a class="row" href={u(`/projects/${p.id}/`)}><b style="font-weight:600">{p.data.title.replace(/ 작업현장$/, '')}</b><span>{p.data.posted.slice(0, 7).replace('-', '.')}</span></a>
        ))}
      </aside>
    </div>
    <div class="waves" aria-hidden="true">
      <svg viewBox="0 0 2880 150" preserveAspectRatio="none"><path fill="#0f5e66" fill-opacity=".45" d="M0 70c240 40 480 40 720 0s480-40 720 0 480 40 720 0 480-40 720 0v80H0z"/></svg>
      <svg class="w2" viewBox="0 0 2880 150" preserveAspectRatio="none"><path fill="#f5f9f9" d="M0 100c240-30 480-30 720 0s480 30 720 0 480-30 720 0 480 30 720 0v50H0z"/></svg>
    </div>
  </section>

  <section style="padding-top:20px">
    <div class="wrap">
      <div class="stats stats-light rv">
        {stats.map((s) => s.placeholder ? (
          <div class="stat ph-stat"><div class="n">수치 입력 필요</div><div class="l">{s.label}</div><div class="s">예: 누적 처리 수량(톤)</div></div>
        ) : (
          <div class="stat"><div class="n"><span data-count={s.value} data-dec={s.decimals ?? 0}>0</span><small>{s.suffix}</small></div><div class="l">{s.label}</div><div class="s">{s.note}</div></div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:40px">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">Solutions</span><h2>현장에 맞춘 5가지 솔루션</h2></div>
        <p>혐기·호기·통성혐기 미생물을 복합화한 환경미생물 제제 <b>SUBION</b>을 기반으로, 오염 원인 진단부터 투여량·기간 설계까지 함께합니다.</p>
      </div>
      <div class="grid g5">
        {solutions.map((s) => (
          <a class="card rv" href={u(`/solutions/#${s.a}`)}>
            <div class="icon"><Icon name={s.icon} /></div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <span class="count-pill">{(() => { const n = s.f.reduce((a, f) => a + byField(f), 0); return n ? `관련 현장 ${n}건` : '관련 현장 자료 보강 필요'; })()}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-deep">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Approach</span><h2>문제를 해결해 가는 방식</h2></div><p>많은 경우 악취·녹조를 현상만 보고 접근합니다. 바이오밴은 원인부터 확인합니다.</p></div>
      <div class="grid g3 steps">
        <div class="step rv"><div class="no">01</div><h3>오염 현장 팩트 체크</h3><p>하수처리장, 하천 등 오염 원인과 주요 오염 지역을 검토합니다.</p></div>
        <div class="step rv"><div class="no">02</div><h3>현장에 최적화</h3><p>투여량과 사업 기간을 협의해 최선의 조건을 만들어 갑니다.</p></div>
        <div class="step rv"><div class="no">03</div><h3>이후 솔루션 제공</h3><p>단기적인 문제 해결뿐 아니라 앞으로의 관리 방향을 제시합니다.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">Featured Projects</span><h2>주요 현장</h2></div>
        <a class="btn btn-line" href={u('/projects/')}>전체 {projects.length}건 보기 <Icon name="arrow" /></a>
      </div>
      <div class="grid g3">{featured.map((p) => <ProjectCard p={p} />)}</div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Data</span><h2>숫자로 보는 현장</h2></div><p>왼쪽 두 차트는 포트폴리오 게시물 30건에서 바로 집계한 실제 값입니다. 오른쪽은 수질 데이터를 받으면 들어갈 자리의 예시입니다.</p></div>
      <div class="grid g2">
        <div style="display:grid;gap:20px">
          <div class="chart rv">
            <h3>지역별 현장 수 <span class="chip">실제 · 게시물 기준</span></h3>
            {regionCounts.map((x) => (
              <div class="hbar"><span>{x.r}</span><span class="t"><i style={`--w:${(x.n / maxR) * 100}%`}></i></span><span class="v">{x.n}</span></div>
            ))}
          </div>
          <div class="chart rv">
            <h3>연도별 게시 현장 <span class="chip">실제 · 게시일 기준</span></h3>
            <div class="yrs">
              {yearList.map((x) => <div><b>{x.n || ''}</b><i style={`--h:${(x.n / maxY) * 80}%`}></i><small>{x.y.slice(2)}</small></div>)}
            </div>
          </div>
        </div>
        <WQChart />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">History</span><h2>1999년부터 이어온 길</h2></div><a class="btn btn-line" href={u('/about/#history')}>전체 연혁 <Icon name="arrow" /></a></div>
      <div class="tl-teaser rv">
        {milestones.map(([y, t]) => <div><b>{y}</b><i></i><p>{t}</p></div>)}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="cta-band rv">
        <div><h2>녹조·악취, 원인부터 함께 보겠습니다</h2><p>현장 위치와 증상을 알려주시면 담당자가 연락드립니다.</p></div>
        <div class="act"><a class="btn btn-primary" href={u('/contact/')}>문의하기</a><a class="btn btn-ghost" href="tel:+82-32-525-2001">032-525-2001</a></div>
      </div>
    </div>
  </section>
</Layout>
