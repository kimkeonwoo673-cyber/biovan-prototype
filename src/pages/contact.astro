---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
const q = encodeURIComponent('인천광역시 부평구 부평대로 337');
---
<Layout title="문의" description="바이오밴코리아 연락처, 오시는 길, 문의">
  <div class="phead"><div class="wrap">
    <div class="crumbs"><a href={u('/')}>홈</a> / 문의</div>
    <h1>문의하기</h1>
    <p>문의를 통해 바이오밴코리아의 전문가와 직접 연락하실 수 있습니다.</p>
  </div></div>
  <section class="bg-white">
    <div class="wrap two">
      <div>
        <span class="eyebrow">Location</span>
        <h2>{site.name}</h2>
        {/* TODO(주소 확정): 부평대로 337 607호(홈·오시는길) vs 부평북로 236번길 12(보도자료 푸터) vs 연수구 한나루로 190(외부 공장 데이터) */}
        <div class="info-row"><Icon name="pin" /><div><b>주소</b>{site.address}<br /><span class="ph">기존 사이트에 주소 2종 혼재 — 확정 필요</span></div></div>
        <div class="info-row"><Icon name="phone" /><div><b>전화</b><a href={`tel:${site.telIntl}`}>{site.tel}</a></div></div>
        <div class="info-row"><Icon name="fax" /><div><b>팩스</b>{site.fax}</div></div>
        <div class="info-row"><Icon name="mail" /><div><b>이메일</b><a href={`mailto:${site.email}`}>{site.email}</a></div></div>
        <div class="info-row" style="border:0"><Icon name="map" /><div><b>지도</b>
          <a href={`https://map.naver.com/p/search/${q}`} target="_blank" rel="noopener">네이버 지도 ↗</a> &nbsp;·&nbsp;
          <a href={`https://map.kakao.com/?q=${q}`} target="_blank" rel="noopener">카카오맵 ↗</a>
          <p class="muted" style="font-size:.82rem;margin:6px 0 0">지도 iframe 대신 링크만 두어 페이지를 가볍게 유지했습니다.</p></div></div>
      </div>
      <div class="card">
        <h3>온라인 문의</h3>
        <div class="notice-box" style="margin:10px 0 18px">프로토타입: 이 양식은 실제로 전송되지 않습니다. 정식 버전에서 카페24 PHP 메일 스크립트 또는 폼 서비스와 연결합니다.</div>
        <form class="form" onsubmit="event.preventDefault();this.querySelector('.ok').hidden=false">
          <div class="row2"><label>성함<input name="name" autocomplete="name" /></label><label>연락처<input name="tel" type="tel" autocomplete="tel" /></label></div>
          <label>이메일 주소<input name="email" type="email" autocomplete="email" /></label>
          <label>서비스 선택<select name="service"><option>악취 제거</option><option>T-N, T-P 저감</option><option>녹조 제거</option><option>토양 정화</option><option>축산환경 개선</option><option>기타</option></select></label>
          <label>문의 내용<textarea name="msg" rows="5" placeholder="현장 위치, 면적·수량, 증상 등을 적어주세요"></textarea></label>
          <button class="btn btn-dark" type="submit">문의하기 (시안)</button>
          <p class="ok notice-box" hidden>시안이라 전송되지 않았습니다. 정식 버전에서는 접수 후 담당자가 연락드립니다.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>
