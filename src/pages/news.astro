---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import news from '../data/news.json';
const press = [...news.press].sort((a, b) => b.date.localeCompare(a.date));
const notice = [...news.notice].sort((a, b) => b.date.localeCompare(a.date));
---
<Layout title="소식" description="바이오밴코리아 보도자료와 공지사항">
  <div class="phead"><div class="wrap">
    <div class="crumbs"><a href={u('/')}>홈</a> / 소식</div>
    <h1>소식</h1>
    <p>보도자료 {press.length}건 · 공지사항 {notice.length}건 (기존 게시판에서 이전)</p>
    <div class="tags" style="margin-top:22px"><a class="btn btn-ghost" href="#press">보도자료</a><a class="btn btn-ghost" href="#notice">공지사항</a></div>
  </div></div>
  <section id="press" class="bg-white">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Press</span><h2>보도자료</h2></div><p>원문 링크가 확인된 기사는 바로 연결됩니다.</p></div>
      <ul class="nlist">
        {press.map((n: any) => (
          <li>
            <time>{n.date.replaceAll('-', '.')}</time>
            <span class="tt">{n.title}</span>
            <span class="lk">
              {n.url && <a href={n.url} target="_blank" rel="noopener nofollow">원문 ↗</a>}
              {n.links && n.links.map((l: any) => <a href={l.url} target="_blank" rel="noopener nofollow">{l.label} ↗</a>)}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section id="notice">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Notice</span><h2>공지사항</h2></div><p>PDF 첨부 자료는 원본을 받아 다시 연결해야 합니다.</p></div>
      <ul class="nlist">
        {notice.map((n: any) => (
          <li><time>{n.date.replaceAll('-', '.')}</time><span class="tt">{n.title}</span><span class="lk">{n.doc && <span class="ph">첨부 이전 필요</span>}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
