---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a, b) => b.data.no - a.data.no);
const rel = (fs: string[]) => projects.filter((p) => p.data.fields.some((f) => fs.includes(f))).slice(0, 6);
const sections = [
  { id: 'algae', icon: 'algae', t: '녹조 및 악취 제거', f: ['녹조', '악취'],
    body: ['기후변화로 여름철 기온이 매년 높아지면서 하천과 저수지의 녹조 발생이 늘고 있습니다. 녹조의 원인 물질은 질소(T-N)와 인(T-P)입니다. 녹조를 없애려면 결국 질소와 인을 제거해야 합니다.',
           '인은 단백질 등의 유기인과 인산염 형태의 무기인으로 존재하며, 침전성 인은 인 분해 미생물의 활동으로 용해성 인으로 변환됩니다. 수중 조류와 식물의 성장에는 정인산염인이 크게 영향을 미칩니다.',
           '토양 속에는 100만 종 이상의 미생물이 균형을 이루며 자정능력을 유지합니다. 부영양화와 화학 오염원은 이 자정능력을 잃게 만듭니다.'] },
  { id: 'river', icon: 'river', t: '하천 정화', f: ['하천'], ph: true,
    body: ['하상에 쌓인 오염 퇴적토(슬러지)를 미생물로 정화해 하천의 자정능력을 회복시킵니다. 대하천 지류의 회복은 녹조와 바다의 적조를 예방하는 방법이기도 합니다.'] },
  { id: 'lake', icon: 'lake', t: '저수지 · 호수 정화', f: ['호수·저수지'], ph: true,
    body: ['준설작업을 거치지 않고도 바닥에 쌓인 유기성 슬러지를 생물학적으로 분해하는 공법입니다. 군포 반월호수, 평택 배다리호수 등에서 녹조 저감과 물고기 폐사 방지 작업을 진행했습니다.'] },
  { id: 'soil', icon: 'soil', t: '토양 정화', f: ['토양'],
    body: ['토양 속 유해한 유기 오염물질을 토양미생물로 독성이 낮거나 유동성이 낮은 상태로 전환합니다.', '특히 탄화수소를 주성분으로 한 유류오염 토양을 비활성 무기 잔류물이나 미생물 증식환경으로 영구히 전환시켜 자연 생태계의 균형을 회복합니다.'] },
  { id: 'livestock', icon: 'barn', t: '축산환경 개선', f: ['축산'],
    body: ['우사·돈사·계사 및 동물원의 악취를 제거하고, 바닥과 벽면의 배설물을 분해해 병원균과 질병 전염을 줄입니다.'],
    list: ['항생제 투여나 축사 소독살균제 사용을 현저히 줄일 수 있음', '급식구 정기 투여로 악취 제거, 파리·모기 발생 억제', '가축의 면역력 증강과 소화기능 촉진, 피부병 방지', '분뇨의 퇴비화 및 무취 유기 액비 생산 → 처리비용 최소화', '육계 사육장 바닥 살포로 암모니아 가스에 의한 호흡기 질병 감소'] },
];
---
<Layout title="솔루션" description="녹조·악취 제거, 하천 정화, 저수지·호수 정화, 토양 정화, 축산환경 개선">
  <div class="phead"><div class="wrap">
    <div class="crumbs"><a href={u('/')}>홈</a> / 솔루션</div>
    <h1>사업영역</h1>
    <p>쾌적한 환경과 아름다운 꿈 — 생태계를 회복시키는 저감 과정.</p>
    <div class="tags" style="margin-top:22px">{sections.map((s) => <a class="btn btn-ghost" href={`#${s.id}`} style="padding:8px 16px">{s.t}</a>)}</div>
  </div></div>
  {sections.map((s, i) => {
    const r = rel(s.f);
    return (
      <section id={s.id} class={i % 2 === 0 ? 'bg-white' : ''}>
        <div class="wrap two">
          <div>
            <div class="icon" style="width:56px;height:56px"><Icon name={s.icon} /></div>
            <h2>{s.t}</h2>
            <div class="prose">{s.body.map((b) => <p>{b}</p>)}</div>
            {s.list && <ul class="list-check">{s.list.map((l) => <li>{l}</li>)}</ul>}
            {s.ph && <p><span class="ph">기존 사이트 해당 페이지 본문이 비어 있음 — 상세 문구 확인 필요</span></p>}
          </div>
          <div>
            <h3 style="font-size:1rem;color:var(--muted)">관련 현장 {r.length > 0 ? `(${projects.filter((p) => p.data.fields.some((f) => s.f.includes(f))).length}건)` : ''}</h3>
            {r.length ? (
              <ul class="nlist">{r.map((p) => <li style="grid-template-columns:70px 1fr auto"><time>{p.data.posted.slice(0, 4)}</time><a class="tt" href={u(`/projects/${p.id}/`)} style="text-decoration:none">{p.data.title}</a><span class="chip r">{p.data.region}</span></li>)}</ul>
            ) : (<div class="notice-box">포트폴리오에 해당 분야 게시물이 없습니다. 연혁상 (주)하림 육계농장 바닥 및 음용 시험(2002.3), 익산 왕궁면 가축분뇨 정화(2012~13) 등의 실적이 있어 사진·자료를 받으면 현장으로 추가할 수 있습니다.</div>)}
          </div>
        </div>
      </section>
    );
  })}
</Layout>
