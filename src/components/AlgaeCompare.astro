---
// 녹조·슬러지 업체 비교 — 표 중심. 데이터: view.json(algae, KRW → USD 환산 완료)
import V from '../content/insights/view.json';
import FxTable from './FxTable.astro';
import { n } from '../lib/num';
const A: any = (V as any).algae;
const rows: any[] = A.rows;
const COMPOSITE: Record<string, string[]> = { dean: ['응집·침전', '생물', '저니처리'], ilshin: ['생물', '산화·살조', '응집·침전'], kwater_vessel: ['물리', '응집·침전'], chungho: ['외부부하 차단(흡착·습지)'] };
const short = (r: any) => r.name.split(' — ')[0];
const members = (k: string) => rows.filter((r) => r.mech === k || (COMPOSITE[r.id] || []).includes(k)).map((r) => short(r) + (r.mech === '복합' && k !== '복합' ? ' (복합)' : '') + (r.cat ? ' (비교 기준)' : ''));
const catRows = [...A.cats.filter((c: any) => c.id !== '복합'), { id: '외부부하 차단(흡착·습지)', desc: '인 흡착 담체·인공습지로 유입수의 T-P·SS를 줄임', np: 'P 유입 감소(외부부하)' }];
const certTxt = (r: any) => (r.cert || []).filter((x: string) => x !== '-' && x !== '미확인').slice(0, 3).join(' · ') || '확인된 인증 없음';
const RY = ['2021', '2022', '2023', '2024', '2025'];
const rec = A.rec;
const now: [string, string][] = [
  ['질소', '질산화·탈질 경로가 있어 메커니즘상 가능. 다만 공개된 측정 데이터가 없음'],
  ['인', "미생물은 인을 분해하지 못함. 결합·반출·용출 억제를 측정으로 보이기 전까지 'T-P 저감'은 근거가 약함"],
  ['퇴적층', '유기 슬러지 분해 주장에 강열감량·두께 수치가 없음. 같은 포지션 경쟁 제품은 수치(강열감량 26.8%→18.7%)와 혁신제품 지정을 갖춤'],
  ['차별점', '무약품·무응집·2차 슬러지 없음. 응집·살조형이 다루지 않는 내부부하(퇴적층)·질소를 겨냥'],
];
const recGroups: [string, string[]][] = [
  ['포지셔닝 제안', [rec.positioning]],
  ['지금 말할 수 있는 것 / 없는 것', now.map(([a, b]) => `${a}: ${b}`)],
  ['유지할 주장', rec.claims_to_keep], ['고칠 표현', rec.claims_to_fix], ['준비할 시험 데이터', rec.tests_to_prepare],
  ['조달 경로', rec.procurement_path || []], ['규제 확인', rec.regulatory_check || []],
];
---
<p class="intro">국내 녹조·하상 슬러지 대응 업체를 작동 원리별로 나누고, 응집제 사용 여부, 질소·인 저감 주장의 근거 수준, 공개 매출(천 USD)을 비교했습니다.</p>
<p class="cv">근거 수준은 공개 자료 기준이며, 찾지 못한 매출은 추정하지 않고 '—'로 두었습니다.</p>

<h3>작동 원리별 분류</h3>
<div class="tblwrap"><table class="tbl s1 stk">
  <thead><tr><th>분류</th><th>원리</th><th>질소·인(N·P) 영향</th><th>해당 업체</th></tr></thead>
  <tbody>{catRows.map((c: any) => <tr><th scope="row">{c.id}</th><td class="w-l" data-l="원리">{c.desc}</td><td class="w-m" data-l="N·P 영향">{c.np}</td><td class="w-m" data-l="해당 업체">{members(c.id).join(' · ') || '—'}</td></tr>)}</tbody>
</table></div>
<p class="mnote">질소는 탈질로 N₂가 되어 수계를 떠날 수 있지만, 인은 분해되지 않습니다. 인을 줄이려면 결합(침전·캡핑), 반출(회수·준설·수확), 저층 산화로 용출 억제 중 하나가 필요합니다.</p>

<h3>업체별 기술 비교</h3>
<div class="tblwrap"><table class="tbl s1">
  <thead><tr><th>업체</th><th>원리</th><th class="c">응집제</th><th>N·P 저감 주장</th><th>근거 수준</th><th>인증·조달</th></tr></thead>
  <tbody>{rows.map((r) => <tr class={r.self ? 'self' : ''}>
    <th scope="row">{r.name}{r.cat && <span class="sub">비교 기준 (업체 아님)</span>}</th>
    <td>{r.mech}{COMPOSITE[r.id] && <span class="sub">{COMPOSITE[r.id].join(' + ')}</span>}</td>
    <td class="c">{r.coag}</td>
    <td class="w-l">{r.np_claim}</td>
    <td>{r.ev}</td>
    <td class="w-m">{certTxt(r)}{r.proc && <span class="sub">{r.proc}</span>}</td>
  </tr>)}</tbody>
</table></div>

<h3>연도별 매출 <span class="unit">(천 USD, 해당 연도 연평균 환율)</span></h3>
<div class="tblwrap"><table class="tbl s1 ytab">
  <thead><tr><th>업체</th>{RY.map((y) => <th class="num">{y}</th>)}<th>출처</th></tr></thead>
  <tbody>{A.rev.map((r: any) => <tr class={r.self ? 'self' : ''}>
    <th scope="row">{r.name.split(' — ')[0]}{r.note && <span class="sub nt">{r.note}</span>}</th>
    {RY.map((y) => { const c = r.cells[y]; return c ? <td class={`num${c.low ? ' est' : ''}`} title={c.tip}>{n(c.v, 0)}</td> : <td class="num dim">—</td>; })}
    <td class="w-s">{r.src}</td>
  </tr>)}</tbody>
</table></div>
<p class="mnote">'—' = 공개 자료 미확인. <i>기울임</i> = 신뢰도 낮음~중(검색 요약 등). 매출은 기업 전체 매출이며 녹조 사업 매출이 아닙니다(예: 에코피스는 해양쓰레기 로봇 등 포함).</p>

<details class="sub"><summary>업체별 상세 (근거 내용 · 퇴적층 · 부작용 · 비용 구조 · 고객)</summary>
  <div class="tblwrap tall"><table class="tbl s1">
    <thead><tr><th>업체</th><th>근거 내용</th><th>퇴적층 · 근본성</th><th>부작용·리스크</th><th>비용 구조</th><th>고객·자료</th></tr></thead>
    <tbody>{rows.map((r) => <tr class={r.self ? 'self' : ''}>
      <th scope="row">{short(r)}</th>
      <td class="w-l">{r.np_ev}{r.valid && <span class="sub">메커니즘 타당성: {r.valid}</span>}</td>
      <td class="w-m">{r.sed}{r.root && <span class="sub">{r.root}</span>}</td>
      <td class="w-m">{r.side}</td>
      <td class="w-m">{r.cost}</td>
      <td class="w-m">{(r.clients || []).join(', ') || '—'}{r.urls.length > 0 && <span class="sub">{r.urls.map((x: string, i: number) => <a href={x} rel="noopener nofollow" target="_blank" style="margin-right:8px">자료{i + 1}</a>)}</span>}</td>
    </tr>)}</tbody>
  </table></div>
</details>

<h3>바이오밴 시사점</h3>
<div class="tblwrap"><table class="tbl stk">
  <thead><tr><th>구분</th><th>내용</th></tr></thead>
  <tbody>{recGroups.flatMap(([g, items]) => items.map((x, i) => <tr>{i === 0 && <th scope="row" rowspan={items.length} class="w-s" style="background:#fff">{g}</th>}<td>{x}</td></tr>))}</tbody>
</table></div>

<details class="mth"><summary>방법·한계</summary>
  <h4>근거 수준 기준</h4>
  <div class="tblwrap"><table class="tbl">
    <thead><tr><th>표시</th><th>기준</th></tr></thead>
    <tbody>
      <tr><th scope="row">논문(독립 실측)</th><td>{A.evscale.E4}</td></tr>
      <tr><th scope="row">공인시험·인증</th><td>{A.evscale.E3}</td></tr>
      <tr><th scope="row">자체자료</th><td>{A.evscale.E2}</td></tr>
      <tr><th scope="row">없음(자사 주장만)</th><td>{A.evscale.E1}</td></tr>
    </tbody>
  </table></div>
  <ul>
    <li>여러 수준이 섞인 업체는 가장 높은 수준을 표시하고 '(범위)'를 붙였습니다.</li>
    <li>매출은 NICE평가정보를 다시 보여주는 기업정보 사이트나 회사 발표 기준입니다. 동명 법인이 많아 일부는 매칭하지 못했습니다.</li>
    <li>원화 금액은 해당 연도 연평균 환율(World Bank)로 USD 환산했습니다. 연도가 없는 원문 금액은 2025년 연평균, 여러 해 누계는 해당 연도들의 평균 환율을 썼습니다. 원화 원값과 적용 환율은 매출 칸에 마우스를 올리면 보입니다.</li>
    <li>신기술 보유 업체도 매출이 줄어든 경우가 있어 인증만으로 매출이 보장되지는 않습니다. 학술 반론(EM류 미생물제가 인을 결합·제거하지 못했다는 Lürling et al. 2010)도 있어 대조구를 둔 현장 데이터가 중요합니다.</li>
    {A.limits.map((x: string) => <li>{x}</li>)}
    <li>출처: 별도 조사 research/algae_competitors.json · ALGAE_COMPETITORS.md (2026-10-08). 바이오밴 정보는 기존 수집본만 사용했습니다.</li>
  </ul>
  <h4>환율표 (1 USD당 현지통화, 연평균)</h4>
  <FxTable />
</details>
