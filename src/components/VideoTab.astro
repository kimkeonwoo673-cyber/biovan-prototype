---
// 영상 자료 분석 탭 — 표 중심. 경량 큐레이션 데이터(video_tab.json, ~40KB) + view.json(핵심 수치·권고 표)만 사용.
import D from '../content/insights/video_tab.json';
import V from '../content/insights/view.json';
import { n } from '../lib/num';
const d: any = D;
const v: any = V;
const pct = (x: any, dg = 0) => (x == null ? '—' : (x * 100).toFixed(dg) + '%');
const p2 = (x: number) => String(x).padStart(2, '0');
const dur = (s: any) => {
  if (s == null) return '—';
  const m = Math.floor(s / 60);
  const r = Math.round(s % 60);
  const h = Math.floor(m / 60);
  return m >= 60 ? `${h}:${p2(m % 60)}:${p2(r)}` : `${m}:${p2(r)}`;
};
const dt = (x: any) => (!x.d ? '미확인' : x.approx ? `약 ${x.d.slice(0, 4)}` : x.d);
const W = ['10y', '5y', '2y'];
const WL: Record<string, string> = { '10y': '10년', '5y': '5년', '2y': '2년' };
const glabel = (s: string) => s.replace(/\s*\(.*\)/, '');
const YA = Array.from({ length: 7 }, (_, i) => 2014 + i), YB = Array.from({ length: 6 }, (_, i) => 2021 + i);
const groups = ['ko', 'en', 'bili', 'dev', 'peer'].map((k) => ({ id: k, ...d.top[k] }));
const bv = d.biovan;
const lift = (c: any) => (c ? `×${n(c.lift, 2)}` : '—');
const memo = (x: any) => [x.ad ? '광고 추정' : '', ...(x.f || []), x.p === 'bilibili' ? 'Bilibili' : ''].filter(Boolean).join(' · ');
const formatNotes: [string, string][] = [
  ['원리 설명', '한국어 ×3.5, 영어 ×2.5, YouTube 중국어 ×5.8 — 가장 일관되게 강함'],
  ['전후 비교', '한국어 ×3.5, 영어 ×1.7'],
  ['쇼츠', '중앙값은 낮지만(×0.3–0.7) 상위 꼬리가 큼(KBS 쇼츠 73만·40만). 노출용 쇼츠 + 검색·신뢰용 3–5분 영상 병행'],
  ['장편 30분+', 'Bilibili(×2.3)·YouTube 중국어(×1.8)에서만 유리'],
];
---
<p class="intro">녹조·수질·미생물 관련 영상 {n(d.meta.n_relevant)}건(YouTube·Bilibili)의 메타데이터로 어떤 포맷이 조회를 얻는지, 바이오밴 영상은 어떤 상태인지 정리했습니다.</p>
<p class="cv">영상은 직접 시청하지 않았고, 업로드 수·리프트는 검색 표본 기반 근사 지수입니다(상관관계).</p>

<h3>핵심 수치</h3>
<div class="tblwrap"><table class="tbl stk">
  <thead><tr><th>항목</th><th>수치</th><th>의미</th></tr></thead>
  <tbody>{v.video_find.map((r: string[]) => <tr><th scope="row" class="w-s">{r[0]}</th><td class="w-m"><b>{r[1]}</b></td><td class="w-l" data-l="의미">{r[2]}</td></tr>)}</tbody>
</table></div>

<h3>바이오밴 자체 영상</h3>
<div class="tblwrap"><table class="tbl stk">
  <thead><tr><th>영상</th><th>채널</th><th>업로드</th><th class="num">조회 (회)</th><th class="num">좋아요</th><th class="num">길이</th></tr></thead>
  <tbody>{bv.videos.map((x: any) => <tr><th scope="row"><a href={x.u} rel="noopener nofollow" target="_blank">{x.t}</a></th><td data-l="채널">{x.ch ?? '미확인'}{x.subs != null && <span class="sub">구독자 {n(x.subs)}</span>}</td><td data-l="업로드">{dt(x)}</td><td class="num" data-l="조회 (회)">{n(x.v)}</td><td class="num" data-l="좋아요">{n(x.lk)}</td><td class="num" data-l="길이">{dur(x.dur)}</td></tr>)}</tbody>
</table></div>
<div class="tblwrap"><table class="tbl stk">
  <thead><tr><th>구분</th><th>내용</th></tr></thead>
  <tbody>
    {bv.diagnosis.map((x: string, i: number) => <tr>{i === 0 && <th scope="row" rowspan={bv.diagnosis.length} class="w-s" style="background:#fff">진단</th>}<td>{x}</td></tr>)}
    <tr><th scope="row" class="w-s">자산</th><td>{bv.assets}</td></tr>
  </tbody>
</table></div>

<h3>10·5·2년 추세 <span class="unit">(관련도순 검색 표본)</span></h3>
<div class="tblwrap"><table class="tbl s1">
  <thead>
    <tr><th rowspan="2">그룹</th><th colspan="3" class="c">연평균 업로드 (표본 지수)</th><th colspan="3" class="c">성숙 일평균 조회 중앙값 (회/일)</th></tr>
    <tr>{[0, 1].map(() => W.map((k) => <th class="num">{WL[k]}</th>))}</tr>
  </thead>
  <tbody>{d.trend.map((t: any) => <tr><th scope="row">{glabel(t.label)}</th>{W.map((k) => <td class="num">{n(t.windows[k].npy, 1)}</td>)}{W.map((k) => <td class="num">{n(t.windows[k].vpd, 2)}</td>)}</tr>)}</tbody>
</table></div>
<div class="tblwrap"><table class="tbl s1">
  <thead>
    <tr><th rowspan="2">그룹</th><th colspan="3" class="c">조회 중앙값 (회)</th><th colspan="3" class="c">쇼츠 비중</th></tr>
    <tr>{[0, 1].map(() => W.map((k) => <th class="num">{WL[k]}</th>))}</tr>
  </thead>
  <tbody>{d.trend.map((t: any) => <tr><th scope="row">{glabel(t.label)}</th>{W.map((k) => <td class="num">{n(Math.round(t.windows[k].vmed))}</td>)}{W.map((k) => <td class="num">{pct(t.windows[k].sh)}</td>)}</tr>)}</tbody>
</table></div>
<p class="mnote">10년=2016-10-08 이후, 5년=2021-10-08 이후, 2년=2024-10-08 이후(누적 구간). YouTube 일본어는 표본이 작아(2년 13개) 참고용입니다.</p>

<details class="sub"><summary>연도별 업로드 수 (표본, 2014–2026)</summary>
  {[YA, YB].map((ys) => <div class="tblwrap"><table class="tbl s1">
    <thead><tr><th>그룹</th>{ys.map((y) => <th class="num">{y}{y === 2026 ? '*' : ''}</th>)}</tr></thead>
    <tbody>{d.trend.map((t: any) => <tr><th scope="row">{glabel(t.label)}</th>{ys.map((y) => <td class="num">{n(t.yearly[y] ?? 0)}</td>)}</tr>)}</tbody>
  </table></div>)}
  <p class="mnote">* 2026년은 10월 8일까지(약 9.3개월). 검색엔진이 최근 영상을 우대해 최근 연도가 과대표집될 수 있습니다.</p>
</details>
<details class="sub"><summary>주제별 추세 ({d.topics.length}개 주제, 전체 표본)</summary>
  <div class="tblwrap"><table class="tbl s1">
    <thead>
      <tr><th rowspan="2">주제</th><th colspan="3" class="c">영상 수</th><th colspan="3" class="c">성숙 일평균 조회 중앙값 (회/일)</th><th rowspan="2" class="num">쇼츠 비중 (2년)</th></tr>
      <tr>{[0, 1].map(() => W.map((k) => <th class="num">{WL[k]}</th>))}</tr>
    </thead>
    <tbody>{d.topics.map((t: any) => <tr><th scope="row">{t.label}</th>{W.map((k) => <td class="num">{n(t.windows[k].n)}</td>)}{W.map((k) => <td class="num">{n(t.windows[k].vpd, 2)}</td>)}<td class="num">{pct(t.windows['2y'].sh)}</td></tr>)}</tbody>
  </table></div>
  <p class="mnote">한 영상이 여러 주제에 들어갈 수 있습니다.</p>
</details>

<h3>포맷·제목 요소별 성과 <span class="unit">(리프트, ×1보다 크면 유리)</span></h3>
<div class="tblwrap"><table class="tbl s1">
  <thead><tr><th>포맷·제목 요소</th>{d.formats.cols.map((c: string) => <th class="num">{c}</th>)}</tr></thead>
  <tbody>
    {d.formats.rows.map((r: any) => <tr><th scope="row">{r.f}</th>{r.cells.map((c: any) => <td class="num" title={c ? `표본 ${c.n}개` : '표본 없음'}>{c ? <>{lift(c)} <span class="dim">({n(c.n)})</span></> : <span class="dim">—</span>}</td>)}</tr>)}
    {d.titles.rows.map((r: any) => <tr><th scope="row">제목: {r.f}</th>{r.cells.map((c: any) => <td class="num" title={c ? `표본 ${c.n}개` : '표본 없음'}>{c ? <>{lift(c)} <span class="dim">({n(c.n)})</span></> : <span class="dim">—</span>}</td>)}</tr>)}
  </tbody>
</table></div>
<div class="tblwrap"><table class="tbl stk">
  <thead><tr><th>포맷</th><th>관찰</th></tr></thead>
  <tbody>{formatNotes.map(([a, b]) => <tr><th scope="row" class="w-s">{a}</th><td>{b}</td></tr>)}</tbody>
</table></div>

<h3>그룹별 조회 상위 영상</h3>
<div class="subtabs" role="tablist" aria-label="영상 그룹 선택" data-sub>
  {groups.map((g, i) => <button class="stab" role="tab" id={`vt-${g.id}`} aria-controls={`vp-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{glabel(g.label)}</button>)}
</div>
{groups.map((g) => (
  <div class="subpanel" role="tabpanel" id={`vp-${g.id}`} aria-labelledby={`vt-${g.id}`} tabindex="0">
    <p class="mnote" style="margin-top:0">{g.note}</p>
    <div class="tblwrap"><table class="tbl vtop stk">
      <thead><tr><th class="num">#</th><th>영상 · 채널</th><th>업로드</th><th class="num">조회 (회)</th><th class="num">좋아요</th><th class="num">길이</th><th>비고</th></tr></thead>
      <tbody>{g.items.map((x: any, i: number) => <tr>
        <td class="num">{i + 1}</td>
        <th scope="row" class="w-l"><a href={x.u} rel="noopener nofollow" target="_blank">{x.t}</a><span class="sub">{x.ch}{x.subs != null ? ` · 구독자 ${n(x.subs)}` : ''}{x.grp ? ` · ${x.grp}` : ''}</span></th>
        <td data-l="업로드">{dt(x)}</td><td class="num" data-l="조회 (회)">{n(x.v)}</td><td class="num" data-l="좋아요">{n(x.lk)}</td><td class="num" data-l="길이">{dur(x.dur)}</td><td data-l="비고">{memo(x) || <span class="dim">—</span>}</td>
      </tr>)}</tbody>
    </table></div>
    {g.organic && (<>
      <h4>광고 추정이 아닌 경쟁사 영상 <span class="unit">(좋아요율 0.2% 이상, 채널당 최대 2개)</span></h4>
      <div class="tblwrap"><table class="tbl vtop">
        <thead><tr><th>영상 · 채널</th><th>업로드</th><th class="num">조회 (회)</th><th class="num">좋아요</th><th class="num">좋아요율</th><th class="num">길이</th></tr></thead>
        <tbody>{g.organic.map((x: any) => <tr><th scope="row" class="w-l"><a href={x.u} rel="noopener nofollow" target="_blank">{x.t}</a><span class="sub">{x.ch}</span></th><td>{dt(x)}</td><td class="num">{n(x.v)}</td><td class="num">{n(x.lk)}</td><td class="num">{n(x.lr, 2)}%</td><td class="num">{dur(x.dur)}</td></tr>)}</tbody>
      </table></div>
      <p class="mnote">Novonesis 상위 영상은 수처리가 아니라 브랜드·채용 캠페인입니다. 교육 시리즈(SePRO 'Algae Corner')가 광고 없이 반응이 가장 좋은 경쟁사 포맷입니다.</p>
    </>)}
  </div>
))}

<h3>경쟁·동종사·공공 채널 <span class="unit">(채널 업로드 전수)</span></h3>
<div class="tblwrap"><table class="tbl s1 vchan">
  <thead><tr><th>채널</th><th>구분</th><th class="num">구독자</th><th class="num">동영상</th><th class="num">쇼츠</th><th class="num">총조회 (회)</th><th>최근 업로드</th></tr></thead>
  <tbody>{d.channels.map((c: any) => <tr class={c.kind === '자사' ? 'self' : ''}><th scope="row"><a href={c.url} rel="noopener nofollow" target="_blank">{c.name}</a></th><td>{c.kind}</td><td class="num">{n(c.subs)}</td><td class="num">{n(c.videos)}</td><td class="num">{n(c.shorts)}</td><td class="num">{n(c.vsum)}</td><td>{c.last}</td></tr>)}</tbody>
</table></div>
<div class="tblwrap"><table class="tbl s1 vchan">
  <thead><tr><th>채널</th><th class="num">조회 중앙값</th><th class="num">업로드 10년</th><th class="num">5년</th><th class="num">2년</th><th class="num">광고 추정 (개)</th><th>대표 영상 (채널 전체 조회 1위)</th></tr></thead>
  <tbody>{d.channels.map((c: any) => <tr class={c.kind === '자사' ? 'self' : ''}><th scope="row">{c.name}</th><td class="num">{n(Math.round(c.vmed))}</td><td class="num">{n(c.u10)}</td><td class="num">{n(c.u5)}</td><td class="num">{n(c.u2)}</td><td class="num">{c.ad ? n(c.ad) : <span class="dim">0</span>}</td>
    <td class="w-m">{c.top.map((t: any) => <><a href={t.u} rel="noopener nofollow" target="_blank">{t.t.length > 48 ? t.t.slice(0, 48) + '…' : t.t}</a><span class="sub">{n(t.v)}회</span></>)}</td></tr>)}</tbody>
</table></div>
<p class="mnote">해외 동종사는 대형 사례 제작 → 유료 광고로 조회 확보 → 지역 TV 출연분 재업로드 → 교육 시리즈로 검색 유입 순으로 운영합니다. 국내 경쟁사는 자체 채널이 미미합니다.</p>

<h3>권고</h3>
<div class="tblwrap"><table class="tbl stk">
  <thead><tr><th>권고</th><th>내용</th><th>근거</th></tr></thead>
  <tbody>{v.video_recs.map((r: string[]) => <tr><th scope="row" class="w-s">{r[0]}</th><td class="w-l">{r[1]}</td><td class="w-m" data-l="근거">{r[2]}</td></tr>)}</tbody>
</table></div>
<h3>제목 예시 <span class="unit">(문제 키워드 + 장소 + 기간/숫자 + 결과/질문)</span></h3>
<div class="tblwrap"><table class="tbl stk">
  <thead><tr><th>언어</th><th>제목 예시</th></tr></thead>
  <tbody>{d.title_ex.map(([l, t]: any) => <tr><td class="w-s">{l}</td><td>{t}</td></tr>)}</tbody>
</table></div>
<p class="mnote">실제 측정값(투명도·COD·T-P·Chl-a 등)이 있는 현장만 제목에 숫자를 넣으세요.</p>

<details class="mth"><summary>방법·한계</summary>
  <ul>
    <li>수집 시점 2026-10-08 ({d.meta.collected}). 원자료 영상 {n(d.meta.n_videos)}건 · 채널 {n(d.meta.n_channels)}개 중 요약·상위 항목만 실었습니다(전체는 research/videos.json, 엑셀 '영상 분석' 시트). 분석 표본: YouTube {n(d.meta.by_platform.youtube)} · Bilibili {n(d.meta.by_platform.bilibili)}.</li>
    <li>추세: 날짜순 검색 편향을 줄이려고 관련도순 검색에서 잡힌 영상만 집계했습니다(Bilibili는 종합·조회수순). '연평균 업로드'는 전체 업로드 수가 아니라 표본 안의 지수입니다.</li>
    <li>성숙 일평균 조회 = 조회 ÷ 업로드 후 일수, 업로드 180일 이상 지난 영상만. 2년 구간 조회 중앙값이 낮은 것은 누적 기간이 짧기 때문입니다.</li>
    <li>리프트 = 해당 포맷(제목 요소)을 가진 영상의 성숙 일평균 조회 중앙값 ÷ 없는 영상의 중앙값(제목 요소는 그룹 전체 중앙값 대비). 괄호는 표본 수. 상관관계이며 방송사 채널 효과가 섞여 있습니다.</li>
    <li>상위 영상: 날짜 앞 '약'은 "N년 전" 표기에서 역산한 근사치(±1년), 좋아요 '—'는 YouTube 차단으로 미수집입니다. '광고 추정' = 조회 10만+ & 좋아요율 0.05% 미만(추정, 확인 불가).</li>
    <li>채널 표의 광고 추정 수는 videos.json 수록 영상 기준(전체 28개 중 이 표의 채널 해당분 25개)이고, 핵심 수치의 32개는 전체 수집 14,428건 기준입니다. 좋아요가 수집되지 않은 영상은 판정하지 않았습니다.</li>
    {d.limits.map((x: string) => <li>{x}</li>)}
    <li>출처: 내부 영상 조사 research/VIDEO.md · videos.json · video_channels.json · research/video/analysis.json. 수집 도구: yt-dlp(검색어 113개, 10개 언어), Bilibili 공개 검색 API(검색어 18개), 추적 채널 22개 전수.</li>
  </ul>
</details>
