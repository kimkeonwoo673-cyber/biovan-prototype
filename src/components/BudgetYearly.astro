---
// 연도별 예산 표·차트 (데이터: src/content/insights/research/budget_yearly.json, 생성: kw/build_budget_yearly.py)
import Y from '../content/insights/research/budget_yearly.json';
interface Props { aggregatesHtml?: boolean }
const D: any = Y;
const YEARS: number[] = D.meta.years;
const groups: any[] = D.groups;
const series: any[] = D.series;
const projects: any[] = D.projects;
const notfound: any[] = D.notfound;

const nf = (n: number, d = 0) => Number(n).toLocaleString('ko-KR', { maximumFractionDigits: d, minimumFractionDigits: 0 });
const esc = (s: any) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const usd = (m: number | null | undefined) => (m == null ? '—' : m >= 1000 ? `$${nf(m / 1000, 2)}B` : `$${nf(m, m < 10 ? 2 : 0)}M`);
// 현지통화 전체 표기
function localFull(v: number | null, unit: string): string {
  if (v == null) return '—';
  switch (unit) {
    case '억원': return v >= 10000 ? `${nf(v / 10000, 2)}조원` : `${nf(v)}억원`;
    case 'KRW m': return `${nf(v / 1e6, 2)}조원`;
    case '亿元': return `${nf(v, 2)}억 위안`;
    case 'USD m': return `$${nf(v, 1)}M`;
    case 'EUR m': return `€${nf(v, 1)}M`;
    case 'JPY bn': return `¥${nf(v, 1)}bn`;
    case 'AUD m': return `A$${nf(v)}M`;
    case 'CAD m': return `C$${nf(v, 2)}M`;
    case 'crore': return `₹${nf(v, 1)} crore`;
    case 'PHP bn': return `₱${nf(v, 2)}bn`;
    case 'Rp trn': return `Rp${nf(v, 2)}조`;
    default: return `${nf(v, 2)} ${unit}`;
  }
}
// 차트 라벨용(단위는 캡션에)
function chartUnit(unit: string, max: number): { div: number; dec: number; label: string } {
  switch (unit) {
    case '억원': return max >= 10000 ? { div: 10000, dec: 2, label: '조원' } : { div: 1, dec: 0, label: '억원' };
    case 'KRW m': return { div: 1e6, dec: 1, label: '조원' };
    case '亿元': return { div: 1, dec: 0, label: '억 위안' };
    case 'USD m': return max >= 1000 ? { div: 1000, dec: 2, label: '십억 달러' } : { div: 1, dec: 1, label: '백만 달러' };
    case 'EUR m': return max >= 1000 ? { div: 1000, dec: 2, label: '십억 유로' } : { div: 1, dec: 0, label: '백만 유로' };
    case 'JPY bn': return { div: 1000, dec: 2, label: '조 엔' };
    case 'AUD m': return { div: 1, dec: 0, label: '백만 호주달러' };
    case 'crore': return { div: 1, dec: 0, label: 'crore 루피(=1천만 루피)' };
    case 'PHP bn': return { div: 1, dec: 2, label: '십억 페소' };
    case 'Rp trn': return { div: 1, dec: 2, label: '조 루피아' };
    default: return { div: 1, dec: 1, label: unit };
  }
}
const CLS_KO: Record<string, string> = D.meta.cls_ko;
function tip(y: string | number, c: any): string {
  const parts = [`${y}년 · ${localFull(c.local, c.unit)}`];
  if (c.cur !== 'USD') parts.push(`≈ ${usd(c.usd)}${c.usd_est ? ' (대체환율·추정)' : ''}`);
  parts.push(`구분: ${CLS_KO[c.cls] || c.cls} — 원문 표기 '${c.status}'${c.provisional ? ' · Eurostat 잠정치(p)' : ''}`);
  if (c.cur !== 'USD' && c.fx) parts.push(`환율: ${nf(c.fx, 4)} ${c.cur}/USD (${c.fx_year}년 World Bank 연평균)${c.fx_note ? ' — ' + c.fx_note : ''}`);
  if (c.period && String(c.period) !== String(y)) parts.push(`기간: ${c.period}`);
  parts.push(`출처: ${c.source_id}`);
  if (c.note) parts.push(`메모: ${c.note}`);
  return parts.join('\n');
}
const COLORS: Record<string, string> = { official: '#13808a', est: '#d9952b', proposal: '#7b5cc4', plan: '#7b5cc4', none: '#bbb' };
function chartSvg(s: any): string | null {
  const slots: { y: string; c: any }[] = YEARS.map((y) => ({ y: String(y), c: s.years[String(y)] || null }));
  const has27 = s.y2027 && s.y2027.local != null;
  if (has27) slots.push({ y: '2027', c: s.y2027 });
  const vals = slots.filter((x) => x.c && x.c.local != null).map((x) => x.c.local);
  if (!vals.length) return null;
  const max = Math.max(...vals);
  const cu = chartUnit(s.unit, max);
  const W = 560, H = 200, L = 8, R = 8, T = 24, Bm = 34;
  const n = slots.length, slot = (W - L - R) / n, bw = Math.min(30, slot * 0.62);
  const ph = H - T - Bm;
  let g = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(s.country + ' ' + s.program + ' 연도별 금액(현지통화)')}" xmlns="http://www.w3.org/2000/svg">`;
  g += `<line x1="${L}" x2="${W - R}" y1="${T + ph}" y2="${T + ph}" stroke="#d5e0e3"/>`;
  slots.forEach((x, i) => {
    const cx = L + slot * i + slot / 2;
    const fut = x.y === '2027';
    if (fut) g += `<rect x="${(cx - slot / 2).toFixed(1)}" y="${T - 14}" width="${slot.toFixed(1)}" height="${ph + 14}" fill="#f4f0fb"/>`;
    g += `<text x="${cx.toFixed(1)}" y="${H - 14}" font-size="10.5" text-anchor="middle" fill="${fut ? '#5b3fa6' : '#6b7d87'}" font-weight="${fut ? 700 : 400}">${x.y}</text>`;
    if (!x.c || x.c.local == null) {
      g += `<text x="${cx.toFixed(1)}" y="${T + ph - 4}" font-size="10" text-anchor="middle" fill="#b5c0c4"><title>${x.y}년: 자료 없음(보간하지 않음)</title>—</text>`;
      return;
    }
    const v = x.c.local, h = Math.max(1.5, (v / max) * ph), y0 = T + ph - h;
    const col = COLORS[x.c.cls] || COLORS.official;
    const open = x.c.cls === 'proposal' || x.c.cls === 'plan';
    const fill = open ? '#ffffff' : x.c.provisional ? '#7cc3bd' : col;
    g += `<g><title>${esc(tip(x.y, x.c))}</title><rect x="${(cx - bw / 2).toFixed(1)}" y="${y0.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="3" fill="${fill}" stroke="${col}" stroke-width="${open ? 2 : 0}"${open ? ' stroke-dasharray="4 3"' : ''}/>`;
    g += `<text x="${cx.toFixed(1)}" y="${(y0 - 5).toFixed(1)}" font-size="10" text-anchor="middle" fill="#0d1f2a" font-weight="600">${esc(nf(v / cu.div, cu.dec))}</text></g>`;
  });
  g += `</svg>`;
  return g;
}
function chartCaption(s: any): string {
  const vals = [...Object.values(s.years).map((c: any) => c.local), s.y2027?.local].filter((v: any) => v != null) as number[];
  return vals.length ? chartUnit(s.unit, Math.max(...vals)).label : '';
}
// 다년 총액 행: 연도 칸 배치
const COLS = [...YEARS.map(String), '2027'];
function totalLayout(t: any) {
  if (!t.span) return { before: 0, span: COLS.length, after: 0, clipped: true };
  const a = Math.max(t.span[0], 2016), b = Math.min(t.span[1], 2027);
  const before = a - 2016, span = Math.max(1, b - a + 1), after = COLS.length - before - span;
  return { before, span, after, clipped: t.span[0] < 2016 || t.span[1] > 2027 };
}
const rng = (n: number) => Array.from({ length: Math.max(0, n) }, (_, i) => i);
const view = groups.map((g) => {
  const ss = series.filter((s) => s.group === g.id).map((s) => ({
    ...s,
    svg: chartSvg(s),
    totalOnly: s.n_years === 0 && !s.y2027,
    showReason: !!s.missing_reason && s.n_years >= 1 && s.n_years <= 10,
    cap: chartCaption(s),
    cells: YEARS.map((y) => ({ y, c: s.years[String(y)] || null })),
    tl: s.totals.map((t: any) => ({ t, L: totalLayout(t) })),
  }));
  return { ...g, ss, pj: projects.filter((p) => g.countries.includes(p.country)), nf: notfound.filter((x) => x.group === g.id) };
});
const cellCls = (c: any) => `yc c-${c.cls}${c.provisional ? ' prov' : ''}`;
const covCls = (s: any) => (s.n_years === 11 ? 'b5' : s.n_years >= 8 ? 'b4' : s.n_years >= 3 ? 'b3' : s.n_years >= 1 ? 'b2' : 'bnone');
---
<p class="note ylegend">
  칸 표기: <span class="yk c-official">공식</span>
  <span class="yk c-est">추정(역산·근사·간접 인용)</span>
  <span class="yk c-proposal">예산안·정부안(미확정)</span>
  <span class="yk prov c-official">공식 통계 잠정치</span>
  <span class="yk empty">— 자료 없음(보간 안 함)</span>
  · USD 앞 <b>≈</b>는 환산값, <b>†</b>는 해당 연도 환율이 없어 다른 해 환율을 쓴 추정입니다. 칸에 마우스를 올리면 원문 표기·환율·출처가 나옵니다.
</p>

<div class="subtabs" role="tablist" aria-label="국가·지역 선택" data-sub>
  {view.map((g, i) => <button class="stab" role="tab" id={`st-${g.id}`} aria-controls={`sp-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{g.label}</button>)}
  <button class="stab" role="tab" id="st-win" aria-controls="sp-win" aria-selected="false" tabindex="-1">기간 창 요약(10·5·2년)</button>
</div>

{view.map((g) => (
  <div class="subpanel" role="tabpanel" id={`sp-${g.id}`} aria-labelledby={`st-${g.id}`} tabindex="0">
    {g.ss.length > 0 && (<>
      <h3>{g.label} — 연도별 금액 (현지통화 · USD)</h3>
      <div class="tblwrap ywrap">
        <table class="tbl ytable">
          <thead><tr>
            <th class="ysticky" scope="col">프로그램 · 범위</th>
            {YEARS.map((y) => <th class="n" scope="col">{y}</th>)}
            <th class="n yfut" scope="col">2027<br /><small>정부안·계획</small></th>
          </tr></thead>
          <tbody>
            {g.ss.map((s) => (<>
              {!s.totalOnly && <tr>
                <th class="ysticky" scope="row"><b>{g.countries.length > 1 ? `${s.country} · ` : ''}{s.program}</b><small class="ysc">{s.scope}</small><span class="ymeta"><span class={`bdg ${covCls(s)}`} title={s.missing_reason || ''}>{s.coverage}</span>{s.sources.map((x: any) => x.url ? <a href={x.url} rel="noopener nofollow" target="_blank">{x.id}</a> : <span>{x.id}</span>)}</span></th>
                {s.cells.map(({ y, c }) => c
                  ? <td class={cellCls(c)} title={tip(y, c)}><span class="yl">{localFull(c.local, c.unit)}</span>{c.cur !== 'USD' && <span class="yu">≈{usd(c.usd)}{c.usd_est ? '†' : ''}</span>}</td>
                  : <td class="yc empty" title={`${y}년: 자료 없음`}>—</td>)}
                {s.y2027 ? (s.y2027.local != null
                  ? <td class={`${cellCls(s.y2027)} yfut`} title={tip(2027, s.y2027)}><span class="yl">{localFull(s.y2027.local, s.y2027.unit)}</span><span class="yu">≈{usd(s.y2027.usd)}†</span></td>
                  : <td class="yc yfut ytext" title={s.y2027.note}><small>{s.y2027.text}</small></td>)
                  : <td class="yc empty yfut">—</td>}
              </tr>}
              {s.tl.map(({ t, L }: any) => (
                <tr class="trow">
                  <th class="ysticky" scope="row">{s.totalOnly ? <><b>{g.countries.length > 1 ? `${s.country} · ` : ''}{s.program}</b><small class="ysc">{s.scope} · 다년 총액만 공개</small></> : <><small>↳ 다년 총액</small><br />{t.label}</>}<span class="ymeta"><span class="bdg bnone">총액만</span>{t.source_url ? <a href={t.source_url} rel="noopener nofollow" target="_blank">{t.source_id}</a> : <span>{t.source_id}</span>}</span></th>
                  {rng(L.before).map(() => <td class="yc"></td>)}
                  <td class={`yc ytotal c-${t.cls}`} colspan={L.span} title={tip(t.period, t)}>
                    <b>{t.period} 총액 {localFull(t.local, t.unit)}</b> <span class="yu">≈{usd(t.usd)}† ({t.fx_year}년 환율 일괄 적용)</span><br /><small>연도별로 나누지 않음{L.clipped ? ` · 기간이 표 범위(2016–2027)를 벗어나 일부만 표시` : ''}{t.note ? ` · ${t.note}` : ''}</small>
                  </td>
                  {rng(L.after).map(() => <td class="yc"></td>)}
                </tr>
              ))}
            </>))}
          </tbody>
        </table>
      </div>
      {g.ss.some((s) => s.showReason) && <p class="note">빈칸 이유: {[...new Set(g.ss.filter((s) => s.showReason).map((s) => s.missing_reason))].join(' / ')}.</p>}
      {g.ss.some((s) => s.svg) && <h3>시리즈별 연도 추이 (현지통화)</h3>}
      <div class="ygrid">
        {g.ss.filter((s) => s.svg).map((s) => (
          <figure class="ychart">
            <figcaption class="yct"><b>{g.countries.length > 1 ? `${s.country} · ` : ''}{s.program}</b> <span class={`bdg ${covCls(s)}`}>{s.coverage}</span></figcaption>
            <Fragment set:html={s.svg} />
            <figcaption>단위: {s.cap}. 막대 위 숫자 = 해당 연도 금액, 빈 연도 '—' = 자료 없음.{s.y2027 && s.y2027.local != null ? ' 보라색 점선 = 2027 정부안(미확정).' : ''}</figcaption>
          </figure>
        ))}
      </div>
      {g.ss.filter((s) => !s.svg).length > 0 && <p class="note">연도별 값이 없어 차트를 그리지 않은 시리즈(다년 총액만 있음): {g.ss.filter((s) => !s.svg).map((s) => s.program).join(', ')}</p>}
    </>)}
    {g.pj.length > 0 && (<>
      <h3>국제기구 차관·원조 사업 (사업 총액 — 연도별 예산 아님)</h3>
      <p class="note">아래 금액은 승인(또는 편성) 시점의 사업 총액이라 연도별 표에 넣지 않았습니다. 집행은 여러 해에 걸쳐 이뤄집니다.</p>
      <div class="tblwrap"><table class="tbl" style="min-width:820px"><thead><tr><th>국가</th><th>사업</th><th class="n">승인·편성 연도</th><th class="n">총액</th><th>구분</th><th>출처·메모</th></tr></thead><tbody>
        {g.pj.map((p) => <tr>
          <td>{p.country}</td><td>{p.program}<br /><small>{p.scope}</small></td>
          <td class="n">{p.year ?? <small>미확인</small>}</td>
          <td class="n">{localFull(p.local, p.unit)}{p.cur !== 'USD' && <><br /><small>≈{usd(p.usd)}</small></>}</td>
          <td><span class={`bdg ${p.cls === 'official' ? 'bofficial' : 'best'}`}>{CLS_KO[p.cls]}</span><br /><small>{p.status}</small></td>
          <td>{p.source_url ? <a href={p.source_url} rel="noopener nofollow" target="_blank">{p.source_id}</a> : p.source_id}{p.note && <><br /><small>{p.note}</small></>}</td>
        </tr>)}
      </tbody></table></div>
    </>)}
    {g.nf.length > 0 && (<>
      <h3>자료 미확인 국가</h3>
      <p>이번 조사에서 공식 연도별 예산을 찾지 못했습니다. 값을 추정해 채우지 않았습니다.</p>
      <div class="tblwrap"><table class="tbl"><thead><tr><th>국가</th><th>상태</th><th>메모</th></tr></thead><tbody>
        {g.nf.map((x) => <tr><td>{x.country}</td><td><span class="bdg bnone">자료 미확인</span></td><td><small>{x.note}{x.detail ? ` · ${x.detail}` : ''}</small></td></tr>)}
      </tbody></table></div>
    </>)}
  </div>
))}
<div class="subpanel" role="tabpanel" id="sp-win" aria-labelledby="st-win" tabindex="0">
  <slot />
</div>
