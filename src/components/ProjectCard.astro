---
import { u } from '../lib/url';
import Icon from './Icon.astro';
import { FIELD_ICON } from './FieldIcon';
const { p } = Astro.props;
const d = p.data;
const f0 = d.fields[0];
const year = d.posted.slice(0, 4);
---
<a class={`pcard f-${f0}`} href={u(`/projects/${p.id}/`)} data-fields={d.fields.join('|')} data-region={d.region}>
  <div class="band">
    <svg class="pat" viewBox="0 0 200 88" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 Q25 48 50 60 T100 60 T150 60 T200 60 V88 H0Z" fill="#fff"/><path d="M0 72 Q25 62 50 72 T100 72 T150 72 T200 72 V88 H0Z" fill="#fff"/><circle cx="168" cy="22" r="26" fill="none" stroke="#fff" stroke-width="2"/></svg>
    <span class="yr">{year}</span>
    <Icon name={FIELD_ICON[f0] ?? 'drop'} class="ic" />
  </div>
  <div class="body">
    <h3>{d.title}</h3>
    <div class="meta"><Icon name="pin" />{d.location}</div>
    <div class="meta"><Icon name="cal" />{d.period}</div>
    <div class="chips">
      {d.fields.map((f: string) => <span class="chip">{f}</span>)}
      <span class="chip r">{d.region}</span>
    </div>
  </div>
</a>
